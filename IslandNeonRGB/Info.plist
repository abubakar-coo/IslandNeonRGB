<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CFBundle* keys are generated by Xcode (GENERATE_INFOPLIST_FILE = YES) and merged with this file. -->

	<!-- Required for ActivityKit: lets the app request Live Activities. -->
	<key>NSSupportsLiveActivities</key>
	<true/>

	<!-- Opts in to a larger (but still budgeted) update allowance for the Live Activity.
	     iOS may ask the user to allow "frequent updates" in Settings. -->
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>

	<key>CFBundleDisplayName</key>
	<string>Island Neon</string>

	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>

	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!-- The app is dark-only so the mock island blends with the real OLED black. -->
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>

	<!-- Deep link used by the Live Activity (widgetURL) to open the Live Activity tab. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.example.IslandNeonRGB</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>islandneonrgb</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
